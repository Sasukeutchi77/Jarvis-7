{
  "expo": {
    "name": "OpenJarvis",
    "slug": "openjarvis",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/OpenJarvis_Circular_Logo.png",
    "scheme": "openjarvis",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/OpenJarvis_Circular_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openjarvis.assistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OpenJarvis utilise le micro pour le contrôle vocal en temps réel.",
        "NSCameraUsageDescription": "OpenJarvis utilise la caméra pour l'analyse visuelle d'images et d'objets.",
        "NSLocationWhenInUseUsageDescription": "OpenJarvis utilise votre position pour la météo et le briefing matinal."
      }
    },
    "android": {
      "package": "com.openjarvis.assistant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/OpenJarvis_Circular_Logo.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/OpenJarvis_Circular_Logo.png",
      "bundler": "metro"
    },
    "extra": {
      "appUrl": "https://ais-pre-fpvigclxkpbuz4pnyohkts-294610358760.europe-west1.run.app"
    }
  }
}
